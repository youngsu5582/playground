   "text": "락은 어디에 저장되나 — 객체 락 vs 행 락",
   "originalText": "락은 어디에 저장되나 — 객체 락 vs 행 락",
   "fontSize": 26,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog-t01-row-lock-where-text-2",
   "type": "text",
   "x": 40,
   "y": 66,
   "width": 333.6,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
