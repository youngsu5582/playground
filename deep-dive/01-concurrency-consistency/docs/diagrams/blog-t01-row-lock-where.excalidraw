  {
   "id": "blog-t01-row-lock-where-text-9",
   "type": "text",
   "x": 756,
   "y": 122,
   "width": 233.92,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
