  {
   "id": "blog-t01-row-lock-where-text-5",
   "type": "text",
   "x": 56,
   "y": 122,
   "width": 184.28,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
