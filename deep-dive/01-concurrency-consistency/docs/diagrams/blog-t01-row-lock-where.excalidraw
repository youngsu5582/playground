   "roundness": null,
   "seed": 1004485640,
   "version": 1,
   "versionNonce": 138625887,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "행 락이 수백만 개여도 락 테이블이 안 터지는 이유",
   "originalText": "행 락이 수백만 개여도 락 테이블이 안 터지는 이유",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
