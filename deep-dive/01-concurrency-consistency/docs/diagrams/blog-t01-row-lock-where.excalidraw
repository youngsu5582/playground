  {
   "id": "blog-t01-row-lock-where-text-13",
   "type": "text",
   "x": 56,
   "y": 372,
   "width": 223.04,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
