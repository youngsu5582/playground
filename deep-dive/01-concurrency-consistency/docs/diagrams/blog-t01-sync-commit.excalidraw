   "text": "위험 창 — 최대 wal_writer_delay (기본 200ms) 의 3배",
   "originalText": "위험 창 — 최대 wal_writer_delay (기본 200ms) 의 3배",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog-t01-sync-commit-text-26",
   "type": "text",
   "x": 1120,
   "y": 248,
   "width": 306.88,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
