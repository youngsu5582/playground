   "roundness": null,
   "seed": 163439034,
   "version": 1,
   "versionNonce": 426501112,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "이 창에서 크래시가 나면 최근 커밋이 사라진다\nDB 는 일관 상태로 복구된다 (커밋 순서대로 재생)",
   "originalText": "이 창에서 크래시가 나면 최근 커밋이 사라진다\nDB 는 일관 상태로 복구된다 (커밋 순서대로 재생)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
