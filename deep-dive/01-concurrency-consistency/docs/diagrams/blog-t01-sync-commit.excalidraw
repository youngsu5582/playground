  {
   "id": "blog-t01-sync-commit-text-30",
   "type": "text",
   "x": 56,
   "y": 418.0,
   "width": 352.8,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
