  {
   "id": "blog-t03-signals-text-6",
   "type": "text",
   "x": 56,
   "y": 149.25,
   "width": 296.38,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
