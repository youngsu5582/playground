  {
   "id": "blog-t05-proxy-text-24",
   "type": "text",
   "x": 56,
   "y": 516.75,
   "width": 985.6000000000001,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
