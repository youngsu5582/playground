   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "각자는 옳은데 합치면 규칙이 깨진다",
   "originalText": "각자는 옳은데 합치면 규칙이 깨진다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog01-write-skew-text-32",
   "type": "text",
   "x": 76,
   "y": 530.0,
   "width": 726.74,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
