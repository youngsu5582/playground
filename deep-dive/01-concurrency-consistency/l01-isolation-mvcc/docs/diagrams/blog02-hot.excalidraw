   "text": "사슬 정리(pruning)는 VACUUM 만 하지 않는다",
   "originalText": "사슬 정리(pruning)는 VACUUM 만 하지 않는다",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog02-hot-text-40",
   "type": "text",
   "x": 756,
   "y": 446.75,
   "width": 446.32,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog02-hot-g-37"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 513767473,
   "version": 1,
   "versionNonce": 1013950122,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "SELECT · UPDATE · DELETE 같은 일반 페이지 접근 중에도 일어난다\n페이지가 거의 찼을 때(여유 10% 미만) · cleanup 락을 막힘 없이 얻을 때",
   "originalText": "SELECT · UPDATE · DELETE 같은 일반 페이지 접근 중에도 일어난다\n페이지가 거의 찼을 때(여유 10% 미만) · cleanup 락을 막힘 없이 얻을 때",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
