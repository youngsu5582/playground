  {
   "id": "blog02-intro-text-22",
   "type": "text",
   "x": 76,
   "y": 362.0,
   "width": 640.64,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
