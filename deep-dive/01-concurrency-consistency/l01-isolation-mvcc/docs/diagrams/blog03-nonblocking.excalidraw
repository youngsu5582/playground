   "type": "text",
   "x": 956,
   "y": 148.0,
   "width": 272.16,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
