   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "행 락   (문서 13.3.2)",
   "originalText": "행 락   (문서 13.3.2)",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog03-nonblocking-text-10",
   "type": "text",
   "x": 506,
   "y": 148.0,
   "width": 137.76,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog03-nonblocking-g-7"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1922513371,
   "version": 1,
   "versionNonce": 1073897531,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "행 락은 데이터 조회에\n영향을 주지 않는다\n같은 행의 쓰는 쪽과\n잠그는 쪽만 막는다",
   "originalText": "행 락은 데이터 조회에\n영향을 주지 않는다\n같은 행의 쓰는 쪽과\n잠그는 쪽만 막는다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
