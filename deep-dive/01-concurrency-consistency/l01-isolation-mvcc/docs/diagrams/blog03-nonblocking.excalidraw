   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "SELECT 가 잡는 ACCESS SHARE 는\nACCESS EXCLUSIVE 와만 충돌한다\nACCESS EXCLUSIVE = ALTER TABLE 류\nDDL 이 잡는 락",
   "originalText": "SELECT 가 잡는 ACCESS SHARE 는\nACCESS EXCLUSIVE 와만 충돌한다\nACCESS EXCLUSIVE = ALTER TABLE 류\nDDL 이 잡는 락",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog03-nonblocking-text-15",
   "type": "text",
   "x": 40,
   "y": 330,
   "width": 351.56,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e03131",
