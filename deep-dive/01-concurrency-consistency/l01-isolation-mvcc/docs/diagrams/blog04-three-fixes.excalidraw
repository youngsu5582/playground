   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog04-three-fixes-text-6",
   "type": "text",
   "x": 56,
   "y": 148.0,
   "width": 495.74000000000007,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
