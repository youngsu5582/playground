  {
   "id": "blog05-dangerous-text-20",
   "type": "text",
   "x": 736,
   "y": 296.75,
   "width": 437.36,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
