   "link": null,
   "locked": false,
   "text": "취소하는 때 — Tout 이 가장 먼저 커밋할 때만",
   "originalText": "취소하는 때 — Tout 이 가장 먼저 커밋할 때만",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog05-dangerous-text-16",
   "type": "text",
   "x": 56,
   "y": 296.75,
   "width": 495.88,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog05-dangerous-g-13"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 489736502,
   "version": 1,
   "versionNonce": 1179702902,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "Tin -rw-> Tpivot -rw-> Tout 이고 Tout 이 Tpivot · Tin 보다 먼저 커밋\n(\"We only roll back a transaction if Tout commits before Tpivot and Tin\")",
   "originalText": "Tin -rw-> Tpivot -rw-> Tout 이고 Tout 이 Tpivot · Tin 보다 먼저 커밋\n(\"We only roll back a transaction if Tout commits before Tpivot and Tin\")",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
