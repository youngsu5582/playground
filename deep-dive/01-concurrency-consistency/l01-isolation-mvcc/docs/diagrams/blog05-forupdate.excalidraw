   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "결과의 차이는 04 에서 본 \"기다린 뒤의 행동\" 과 같은 규칙이다",
   "originalText": "결과의 차이는 04 에서 본 \"기다린 뒤의 행동\" 과 같은 규칙이다",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog05-forupdate-text-14",
   "type": "text",
   "x": 56,
   "y": 406.75,
   "width": 805.2800000000001,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog05-forupdate-g-11"
