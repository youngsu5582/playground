   "frameId": null,
   "roundness": null,
   "seed": 629945955,
   "version": 1,
   "versionNonce": 1036576287,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "RC 는 최신 버전을 받아들여 계속하고, RR 은 스냅샷 이후 바뀐 행을 거부한다. 이 방법의 한계(팬텀)는 잠길 행이 아직 없는 경우다",
   "originalText": "RC 는 최신 버전을 받아들여 계속하고, RR 은 스냅샷 이후 바뀐 행을 거부한다. 이 방법의 한계(팬텀)는 잠길 행이 아직 없는 경우다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
