   "seed": 278339389,
   "version": 1,
   "versionNonce": 2088760521,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "다른 트랜잭션을 기다리게 하지 않는다\n-> 데드락에 참여하지 않는다\npg_locks 에 mode = SIReadLock 으로 보인다",
   "originalText": "다른 트랜잭션을 기다리게 하지 않는다\n-> 데드락에 참여하지 않는다\npg_locks 에 mode = SIReadLock 으로 보인다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
