  },
  {
   "id": "blog05-siread-text-6",
   "type": "text",
   "x": 56,
   "y": 148.0,
   "width": 289.52,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
