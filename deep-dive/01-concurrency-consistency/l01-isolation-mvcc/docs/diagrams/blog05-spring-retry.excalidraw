   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog05-spring-retry-text-14",
   "type": "text",
   "x": 56,
   "y": 426.75,
   "width": 389.48,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog05-spring-retry-g-11"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 676066770,
   "version": 1,
   "versionNonce": 1552011924,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "프록시를 안 거쳐 트랜잭션이 안 열린다 (self-invocation 경고)\n-> 재시도 래퍼와 트랜잭션 메서드는 다른 빈에 둔다",
   "originalText": "프록시를 안 거쳐 트랜잭션이 안 열린다 (self-invocation 경고)\n-> 재시도 래퍼와 트랜잭션 메서드는 다른 빈에 둔다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
