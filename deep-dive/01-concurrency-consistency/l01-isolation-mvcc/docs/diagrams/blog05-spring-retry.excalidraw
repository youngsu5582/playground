   "roundness": null,
   "seed": 2034334427,
   "version": 1,
   "versionNonce": 1947363536,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "트랜잭션은 프록시 경계에서 시작 · 종료된다. Spring 문서 자체는 재시도 위치를 규정하지 않는다",
   "originalText": "트랜잭션은 프록시 경계에서 시작 · 종료된다. Spring 문서 자체는 재시도 위치를 규정하지 않는다",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
