   "text": "Spring 에서 재시도는 @Transactional 경계의 바깥에 둔다 (해석)",
   "originalText": "Spring 에서 재시도는 @Transactional 경계의 바깥에 둔다 (해석)",
   "fontSize": 26,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog05-spring-retry-text-2",
   "type": "text",
   "x": 40,
   "y": 66,
   "width": 647.1,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
