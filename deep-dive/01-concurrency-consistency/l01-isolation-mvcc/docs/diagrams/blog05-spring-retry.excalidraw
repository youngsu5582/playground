  {
   "id": "blog05-spring-retry-text-18",
   "type": "text",
   "x": 736,
   "y": 426.75,
   "width": 495.55999999999995,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
