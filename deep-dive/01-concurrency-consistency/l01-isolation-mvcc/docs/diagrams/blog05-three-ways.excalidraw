  {
   "id": "blog05-three-ways-text-17",
   "type": "text",
   "x": 56,
   "y": 412,
   "width": 828.9,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog05-three-ways-g-15"
