  {
   "id": "blog06-defenses-text-10",
   "type": "text",
   "x": 736,
   "y": 149.25,
   "width": 358.96000000000004,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog06-defenses-g-7"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 567589945,
   "version": 1,
   "versionNonce": 2032272033,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "idle_in_transaction_session_timeout — 기본 0 (꺼짐)\n트랜잭션 안에서 idle 인 세션을 끊는다\n예: ALTER ROLE app_user SET\n      idle_in_transaction_session_timeout = '5min';\nidle_session_timeout 은 트랜잭션 밖 idle 세션을 끊는다",
   "originalText": "idle_in_transaction_session_timeout — 기본 0 (꺼짐)\n트랜잭션 안에서 idle 인 세션을 끊는다\n예: ALTER ROLE app_user SET\n      idle_in_transaction_session_timeout = '5min';\nidle_session_timeout 은 트랜잭션 밖 idle 세션을 끊는다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
