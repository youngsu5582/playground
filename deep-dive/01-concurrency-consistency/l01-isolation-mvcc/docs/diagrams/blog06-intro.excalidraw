  {
   "id": "blog06-intro-text-36",
   "type": "text",
   "x": 76,
   "y": 614.0,
   "width": 681.94,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
