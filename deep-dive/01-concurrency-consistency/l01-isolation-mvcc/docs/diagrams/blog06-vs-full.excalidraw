   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog06-vs-full-text-14",
   "type": "text",
   "x": 56,
   "y": 416.75,
   "width": 801.36,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog06-vs-full-g-11"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 210410291,
   "version": 1,
   "versionNonce": 1492063607,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "한 번 부푼 테이블은 그냥 두면 줄지 않는다 — 부푼 뒤의 조치는 비싸다. 그래서 예방(짧은 트랜잭션 · 타임아웃)이 핵심이다 (해석)",
   "originalText": "한 번 부푼 테이블은 그냥 두면 줄지 않는다 — 부푼 뒤의 조치는 비싸다. 그래서 예방(짧은 트랜잭션 · 타임아웃)이 핵심이다 (해석)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
