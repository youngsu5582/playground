   "link": null,
   "locked": false,
   "text": "SELECT datname, age(datfrozenxid) FROM pg_database;      테이블별은 age(relfrozenxid)\npg_xact 크기는 autovacuum_freeze_max_age 에 비례한다 — 기본 2억이면 약 50MB",
   "originalText": "SELECT datname, age(datfrozenxid) FROM pg_database;      테이블별은 age(relfrozenxid)\npg_xact 크기는 autovacuum_freeze_max_age 에 비례한다 — 기본 2억이면 약 50MB",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
