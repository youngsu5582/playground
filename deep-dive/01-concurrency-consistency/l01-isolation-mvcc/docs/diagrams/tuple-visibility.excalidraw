   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "판정에 쓰이는 것은 버전 헤더와 스냅샷뿐",
   "originalText": "판정에 쓰이는 것은 버전 헤더와 스냅샷뿐",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "tuple-visibility-text-36",
   "type": "text",
   "x": 56,
   "y": 615.5,
   "width": 724.7800000000001,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "tuple-visibility-g-33"
