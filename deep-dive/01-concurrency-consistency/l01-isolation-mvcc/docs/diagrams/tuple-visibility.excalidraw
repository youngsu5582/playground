   "frameId": null,
   "roundness": null,
   "seed": 489499242,
   "version": 1,
   "versionNonce": 341350387,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "읽기는 행 버전의 xmin/xmax 와 스냅샷만 비교해 판정한다. 아무도 보지 못하게 된 옛 버전(v1)은 VACUUM 이 치운다",
   "originalText": "읽기는 행 버전의 xmin/xmax 와 스냅샷만 비교해 판정한다. 아무도 보지 못하게 된 옛 버전(v1)은 VACUUM 이 치운다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
