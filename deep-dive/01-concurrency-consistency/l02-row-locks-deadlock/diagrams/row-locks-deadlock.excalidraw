  {
   "id": "row-locks-deadlock-text-88",
   "type": "text",
   "x": 796,
   "y": 435.5,
   "width": 320.04,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "row-locks-deadlock-g-85"
