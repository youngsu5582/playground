  {
   "id": "blog01-intro-text-10",
   "type": "text",
   "x": 576,
   "y": 138.0,
   "width": 398.72,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
