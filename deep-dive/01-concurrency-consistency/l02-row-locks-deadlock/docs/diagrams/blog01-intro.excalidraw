   "text": "층 2 — 행 수준: id = 7 튜플에 FOR UPDATE",
   "originalText": "층 2 — 행 수준: id = 7 튜플에 FOR UPDATE",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog01-intro-text-14",
   "type": "text",
   "x": 576,
   "y": 328.0,
   "width": 393.12,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog01-intro-g-11"
   ],
