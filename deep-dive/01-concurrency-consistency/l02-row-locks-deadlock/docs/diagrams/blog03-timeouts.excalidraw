   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "statement_timeout 이 0 이 아닐 때 lock_timeout 을 같거나 큰 값으로 두면\n의미가 없다 — 문장 타임아웃이 먼저 걸린다\n둘 다 postgresql.conf 에 두는 것은 비권장 (모든 세션에 적용)",
   "originalText": "statement_timeout 이 0 이 아닐 때 lock_timeout 을 같거나 큰 값으로 두면\n의미가 없다 — 문장 타임아웃이 먼저 걸린다\n둘 다 postgresql.conf 에 두는 것은 비권장 (모든 세션에 적용)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
