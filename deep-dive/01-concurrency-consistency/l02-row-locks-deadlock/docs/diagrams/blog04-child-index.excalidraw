   "text": "부모 DELETE 는 자식에서 일치하는 행을 찾아야 한다",
   "originalText": "부모 DELETE 는 자식에서 일치하는 행을 찾아야 한다",
   "fontSize": 26,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog04-child-index-text-2",
   "type": "text",
   "x": 40,
   "y": 66,
   "width": 812.4000000000001,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
