  },
  {
   "id": "blog04-why-two-modes-text-6",
   "type": "text",
   "x": 56,
   "y": 169.25,
   "width": 159.9,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
