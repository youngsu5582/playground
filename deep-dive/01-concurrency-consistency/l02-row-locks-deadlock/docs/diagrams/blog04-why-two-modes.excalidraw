   "seed": 455559895,
   "version": 1,
   "versionNonce": 275011750,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "위 문장은 모드 정의에서 이은 해석이다. 두 모드를 둔 도입 이유를 문서가 따로 적은 것은 찾지 못했다 (해석)",
   "originalText": "위 문장은 모드 정의에서 이은 해석이다. 두 모드를 둔 도입 이유를 문서가 따로 적은 것은 찾지 못했다 (해석)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
