   "seed": 983131549,
   "version": 1,
   "versionNonce": 128729621,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "자식 행을 넣는 동안\n부모가 존재해야 하고\n지워지지 않아야 한다\n\n= 부모의 키가 안 바뀌고\n  안 지워지면 안전하다",
   "originalText": "자식 행을 넣는 동안\n부모가 존재해야 하고\n지워지지 않아야 한다\n\n= 부모의 키가 안 바뀌고\n  안 지워지면 안전하다",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
