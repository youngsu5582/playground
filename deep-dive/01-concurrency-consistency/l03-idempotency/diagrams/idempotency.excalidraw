  {
   "id": "idempotency-text-65",
   "type": "text",
   "x": 766,
   "y": 718.75,
   "width": 428.48,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
