  {
   "id": "blog01-key-flow-text-40",
   "type": "text",
   "x": 56,
   "y": 478.0,
   "width": 451.23,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
