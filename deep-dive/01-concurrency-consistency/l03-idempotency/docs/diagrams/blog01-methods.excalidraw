   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "POST 는 서버가 별도 장치를 둬야 한다",
   "originalText": "POST 는 서버가 별도 장치를 둬야 한다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
