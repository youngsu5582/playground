  {
   "id": "blog01-terms-text-18",
   "type": "text",
   "x": 56,
   "y": 339.25,
   "width": 853.0500000000001,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
