   "text": "PostgreSQL 은 이 모양이 아니다",
   "originalText": "PostgreSQL 은 이 모양이 아니다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
