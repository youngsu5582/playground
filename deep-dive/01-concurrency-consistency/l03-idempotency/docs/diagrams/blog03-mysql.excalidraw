   "seed": 894630420,
   "version": 1,
   "versionNonce": 1945477521,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "PostgreSQL 의 방식은 접힌 칸(문서 64.5)이고 이 모양과 다르다\n(해석 — PostgreSQL 쪽에서 같은 상황의 교착이 안 나는지는 직접 돌려 보지 않았다)",
   "originalText": "PostgreSQL 의 방식은 접힌 칸(문서 64.5)이고 이 모양과 다르다\n(해석 — PostgreSQL 쪽에서 같은 상황의 교착이 안 나는지는 직접 돌려 보지 않았다)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
