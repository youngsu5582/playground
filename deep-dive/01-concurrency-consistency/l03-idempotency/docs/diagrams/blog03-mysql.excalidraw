  },
  {
   "id": "blog03-mysql-text-25",
   "type": "text",
   "x": 56,
   "y": 328.0,
   "width": 530.32,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog03-mysql-g-22"
