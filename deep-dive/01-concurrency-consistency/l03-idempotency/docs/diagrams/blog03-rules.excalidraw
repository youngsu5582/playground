   "versionNonce": 1689299425,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "그 트랜잭션이 커밋 또는 중단될 때까지 기다린 뒤\n검사를 반복한다",
   "originalText": "그 트랜잭션이 커밋 또는 중단될 때까지 기다린 뒤\n검사를 반복한다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
