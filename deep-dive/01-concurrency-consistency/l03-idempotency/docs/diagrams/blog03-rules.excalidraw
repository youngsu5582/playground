   "text": "3  지워지는 중인 유효한 행",
   "originalText": "3  지워지는 중인 유효한 행",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog03-rules-text-14",
   "type": "text",
   "x": 56,
   "y": 328.0,
   "width": 307.44,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
