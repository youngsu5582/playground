   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "CTE 는 동시 요청 아래에서 빈 결과를 돌려줄 수 있다",
   "originalText": "CTE 는 동시 요청 아래에서 빈 결과를 돌려줄 수 있다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog04-cte-trap-text-30",
   "type": "text",
   "x": 76,
   "y": 530.0,
   "width": 839.44,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog04-cte-trap-g-27"
