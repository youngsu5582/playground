   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog04-rc-text-2",
   "type": "text",
   "x": 40,
   "y": 66,
   "width": 736.1999999999999,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
