   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "ON CONFLICT (key) DO UPDATE SET status = 'IN_PROGRESS'\nWHERE idempotency_keys.status = 'FAILED' AND idempotency_keys.request_hash = EXCLUDED.request_hash\nRETURNING status;",
   "originalText": "ON CONFLICT (key) DO UPDATE SET status = 'IN_PROGRESS'\nWHERE idempotency_keys.status = 'FAILED' AND idempotency_keys.request_hash = EXCLUDED.request_hash\nRETURNING status;",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
