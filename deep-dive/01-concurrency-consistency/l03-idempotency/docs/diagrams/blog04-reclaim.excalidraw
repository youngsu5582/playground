   "text": "INSERT INTO idempotency_keys(key, request_hash, status) VALUES ('p2','h1','IN_PROGRESS')",
   "originalText": "INSERT INTO idempotency_keys(key, request_hash, status) VALUES ('p2','h1','IN_PROGRESS')",
