   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "SET LOCAL lock_timeout = '…' 후 선점\n→ 타임아웃을 409 로\n\n한 트랜잭션 설계에서 바운드를 둔다",
   "originalText": "SET LOCAL lock_timeout = '…' 후 선점\n→ 타임아웃을 409 로\n\n한 트랜잭션 설계에서 바운드를 둔다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
