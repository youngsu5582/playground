  {
   "id": "blog06-lock-timeout-text-34",
   "type": "text",
   "x": 76,
   "y": 614.0,
   "width": 739.62,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
