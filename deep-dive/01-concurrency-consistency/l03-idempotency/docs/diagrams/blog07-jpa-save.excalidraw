   "seed": 1960677839,
   "version": 1,
   "versionNonce": 1879077033,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "선점은 JdbcTemplate/네이티브 쿼리의 INSERT … ON CONFLICT DO NOTHING + 영향 행 수로 하고, JPA 엔티티는 선점 뒤의 읽기 · 저장에 쓴다",
   "originalText": "선점은 JdbcTemplate/네이티브 쿼리의 INSERT … ON CONFLICT DO NOTHING + 영향 행 수로 하고, JPA 엔티티는 선점 뒤의 읽기 · 저장에 쓴다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
