  {
   "id": "stock-concurrency-text-44",
   "type": "text",
   "x": 616,
   "y": 209.25,
   "width": 547.84,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
