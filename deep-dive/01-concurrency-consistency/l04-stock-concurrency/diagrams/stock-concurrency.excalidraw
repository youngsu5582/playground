  {
   "id": "stock-concurrency-text-48",
   "type": "text",
   "x": 616,
   "y": 419.25,
   "width": 666.4,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
