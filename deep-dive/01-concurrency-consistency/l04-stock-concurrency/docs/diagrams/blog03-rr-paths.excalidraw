  {
   "id": "blog03-rr-paths-text-6",
   "type": "text",
   "x": 56,
   "y": 149.25,
   "width": 326.25,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
