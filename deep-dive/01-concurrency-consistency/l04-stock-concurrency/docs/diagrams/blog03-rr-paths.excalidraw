  },
  {
   "id": "blog03-rr-paths-text-10",
   "type": "text",
   "x": 776,
   "y": 149.25,
   "width": 477.15000000000003,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
