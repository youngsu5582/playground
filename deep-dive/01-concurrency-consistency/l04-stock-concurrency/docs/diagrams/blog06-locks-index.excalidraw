   "link": null,
   "locked": false,
   "text": "PostgreSQL 의 \"행 락은 그 행만\" 이 InnoDB 에서는 인덱스 설계에 달려 있다",
   "originalText": "PostgreSQL 의 \"행 락은 그 행만\" 이 InnoDB 에서는 인덱스 설계에 달려 있다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog06-locks-index-text-14",
   "type": "text",
   "x": 56,
   "y": 348.0,
   "width": 491.99999999999994,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
