   "seed": 1882230578,
   "version": 1,
   "versionNonce": 1262282407,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "인덱스 없는 조건으로 차감하면 락이 한 행이 아니라 스캔한 범위로 번진다\n한 SKU 차감이 다른 SKU 를 막는 장애로 이어진다",
   "originalText": "인덱스 없는 조건으로 차감하면 락이 한 행이 아니라 스캔한 범위로 번진다\n한 SKU 차감이 다른 SKU 를 막는 장애로 이어진다",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
