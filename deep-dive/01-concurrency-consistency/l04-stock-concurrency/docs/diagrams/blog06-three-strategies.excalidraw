   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "WHERE version = ? 는\n최신 커밋 행에 평가되어\n충돌 시 0 행이 된다\n\nPostgreSQL RR 처럼 40001 로\n먼저 막는 경로가 없다\n(직접 확인하지 않았다)",
   "originalText": "WHERE version = ? 는\n최신 커밋 행에 평가되어\n충돌 시 0 행이 된다\n\nPostgreSQL RR 처럼 40001 로\n먼저 막는 경로가 없다\n(직접 확인하지 않았다)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
