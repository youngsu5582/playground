   "frameId": null,
   "roundness": null,
   "seed": 231351945,
   "version": 1,
   "versionNonce": 24652361,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "REPEATABLE READ 트랜잭션에서 SELECT COUNT(...) 는 0 인데 UPDATE 는 10 행을 바꾼다 —\n다른 트랜잭션이 방금 커밋한 행에 DELETE / UPDATE 가 영향을 줄 수 있고, 바뀐 행은 현재 트랜잭션에 보이게 된다",
   "originalText": "REPEATABLE READ 트랜잭션에서 SELECT COUNT(...) 는 0 인데 UPDATE 는 10 행을 바꾼다 —\n다른 트랜잭션이 방금 커밋한 행에 DELETE / UPDATE 가 영향을 줄 수 있고, 바뀐 행은 현재 트랜잭션에 보이게 된다",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
