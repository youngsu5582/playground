  {
   "id": "blog06-two-worlds-text-10",
   "type": "text",
   "x": 776,
   "y": 150.5,
   "width": 302.7,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
