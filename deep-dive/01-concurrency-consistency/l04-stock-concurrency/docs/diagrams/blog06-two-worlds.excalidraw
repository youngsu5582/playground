  {
   "id": "blog06-two-worlds-text-14",
   "type": "text",
   "x": 56,
   "y": 408.0,
   "width": 722.4,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
