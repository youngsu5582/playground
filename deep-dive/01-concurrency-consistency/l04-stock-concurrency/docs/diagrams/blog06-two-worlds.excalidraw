   "seed": 1522111460,
   "version": 1,
   "versionNonce": 1170206198,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "최신 커밋 데이터에 적용된다\nFOR UPDATE 는 읽은 각 행에 배타 락을 건다\n(검색된 UPDATE 가 거는 것과 같은 락)\n\n락은 커밋 · 롤백에서 풀린다",
   "originalText": "최신 커밋 데이터에 적용된다\nFOR UPDATE 는 읽은 각 행에 배타 락을 건다\n(검색된 UPDATE 가 거는 것과 같은 락)\n\n락은 커밋 · 롤백에서 풀린다",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
