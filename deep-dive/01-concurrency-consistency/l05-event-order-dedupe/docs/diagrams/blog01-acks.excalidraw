  {
   "id": "blog01-acks-text-14",
   "type": "text",
   "x": 936,
   "y": 158.0,
   "width": 247.51999999999998,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog01-acks-g-11"
