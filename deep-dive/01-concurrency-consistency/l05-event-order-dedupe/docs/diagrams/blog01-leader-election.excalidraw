  {
   "id": "blog01-leader-election-text-11",
   "type": "text",
   "x": 56,
   "y": 323.0,
   "width": 206.57,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog01-leader-election-g-8"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 163439034,
   "version": 1,
   "versionNonce": 426501112,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759708800000,
   "link": null,
   "locked": false,
   "text": "ISR 복제본이 돌아오길 기다린다\n(0.11.0.0 이후 기본, 가용성을 희생)\n\n가용성을 내주는 대신\n커밋된 메시지는 지켜진다",
   "originalText": "ISR 복제본이 돌아오길 기다린다\n(0.11.0.0 이후 기본, 가용성을 희생)\n\n가용성을 내주는 대신\n커밋된 메시지는 지켜진다",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
