  {
   "id": "blog02-key-text-10",
   "type": "text",
   "x": 716,
   "y": 148.0,
   "width": 302.12,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
