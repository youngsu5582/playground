   "text": "확인과 삽입이 두 단계라 사이가 샌다",
   "originalText": "확인과 삽입이 두 단계라 사이가 샌다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
