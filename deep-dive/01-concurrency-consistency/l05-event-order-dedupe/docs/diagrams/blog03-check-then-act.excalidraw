  {
   "id": "blog03-check-then-act-text-30",
   "type": "text",
   "x": 76,
   "y": 530.0,
   "width": 862.12,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
