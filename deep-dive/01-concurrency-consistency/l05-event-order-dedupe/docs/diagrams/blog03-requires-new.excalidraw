   "text": "inbox 저장을 다른 빈의 REQUIRES_NEW 로 뺀다",
   "originalText": "inbox 저장을 다른 빈의 REQUIRES_NEW 로 뺀다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
