  },
  {
   "id": "blog03-requires-new-text-10",
   "type": "text",
   "x": 716,
   "y": 158.0,
   "width": 240.24,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog03-requires-new-g-7"
   ],
   "frameId": null,
