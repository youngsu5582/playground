  {
   "id": "blog04-lt-le-text-14",
   "type": "text",
   "x": 56,
   "y": 403.0,
   "width": 730.08,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
