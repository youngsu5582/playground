   "link": null,
   "locked": false,
   "text": "INSERT INTO shipment\n  (id, version, status, change_count)\nVALUES (?, ?, ?, 1)\nON CONFLICT (id) DO UPDATE\n   SET version = EXCLUDED.version,\n       status = EXCLUDED.status,\n       change_count = shipment.change_count + 1\n WHERE shipment.version < EXCLUDED.version;",
   "originalText": "INSERT INTO shipment\n  (id, version, status, change_count)\nVALUES (?, ?, ?, 1)\nON CONFLICT (id) DO UPDATE\n   SET version = EXCLUDED.version,\n       status = EXCLUDED.status,\n       change_count = shipment.change_count + 1\n WHERE shipment.version < EXCLUDED.version;",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
