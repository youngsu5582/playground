  {
   "id": "blog05-side-effect-text-40",
   "type": "text",
   "x": 56,
   "y": 472,
   "width": 596.48,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
