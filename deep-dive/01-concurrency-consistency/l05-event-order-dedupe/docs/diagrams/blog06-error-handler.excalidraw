   "text": "배치 리스너 · 시도 횟수",
   "originalText": "배치 리스너 · 시도 횟수",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
