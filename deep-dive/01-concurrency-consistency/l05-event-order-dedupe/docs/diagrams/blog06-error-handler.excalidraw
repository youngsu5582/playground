  },
  {
   "id": "blog06-error-handler-text-33",
   "type": "text",
   "x": 56,
   "y": 508.0,
   "width": 811.1999999999999,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog06-error-handler-g-30"
