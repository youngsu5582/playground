   "link": null,
   "locked": false,
   "text": "INSERT INTO shipment (id, version, status) VALUES (?, ?, ?) AS new\nON DUPLICATE KEY UPDATE\n  status  = IF(new.version > version, new.status,  status),\n  version = IF(new.version > version, new.version, version);",
   "originalText": "INSERT INTO shipment (id, version, status) VALUES (?, ?, ?) AS new\nON DUPLICATE KEY UPDATE\n  status  = IF(new.version > version, new.status,  status),\n  version = IF(new.version > version, new.version, version);",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
