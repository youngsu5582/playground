  },
  {
   "id": "blog06-mysql-rows-text-22",
   "type": "text",
   "x": 56,
   "y": 448.0,
   "width": 478.27,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
