  {
   "id": "dup-order-paths-text-8",
   "type": "text",
   "x": 81,
   "y": 208.0,
   "width": 398.58,
   "height": 48.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
