   "link": null,
   "locked": false,
   "text": "2  컨슈머가 처리한 뒤 오프셋 커밋 전에 죽음",
   "originalText": "2  컨슈머가 처리한 뒤 오프셋 커밋 전에 죽음",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "dup-order-paths-text-12",
   "type": "text",
   "x": 81,
   "y": 383.0,
   "width": 390.78,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "dup-order-paths-g-9"
   ],
