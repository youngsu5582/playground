  {
   "id": "dup-order-paths-text-16",
   "type": "text",
   "x": 81,
   "y": 598.0,
   "width": 396.5,
   "height": 48.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
