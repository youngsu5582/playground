  },
  {
   "id": "blog01-binary-text-6",
   "type": "text",
   "x": 56,
   "y": 149.25,
   "width": 346.64,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog01-binary-g-3"
   ],
   "frameId": null,
