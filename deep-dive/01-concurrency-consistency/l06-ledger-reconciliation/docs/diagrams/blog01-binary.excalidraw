   "link": null,
   "locked": false,
   "text": "0.5 · 0.25 · 0.125  (2 의 거듭제곱 분수)",
   "originalText": "0.5 · 0.25 · 0.125  (2 의 거듭제곱 분수)",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
