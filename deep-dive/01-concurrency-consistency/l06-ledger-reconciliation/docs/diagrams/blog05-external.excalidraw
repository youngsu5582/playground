  {
   "id": "blog05-external-text-45",
   "type": "text",
   "x": 56,
   "y": 382,
   "width": 361.6,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog05-external-g-43"
   ],
