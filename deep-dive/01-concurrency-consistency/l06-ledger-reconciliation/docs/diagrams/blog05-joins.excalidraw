  {
   "id": "blog05-joins-text-48",
   "type": "text",
   "x": 56,
   "y": 412,
   "width": 384.64,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "blog05-joins-g-46"
   ],
   "frameId": null,
