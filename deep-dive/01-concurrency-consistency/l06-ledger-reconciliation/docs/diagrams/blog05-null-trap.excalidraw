   "link": null,
   "locked": false,
   "text": "COALESCE 없이",
   "originalText": "COALESCE 없이",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
