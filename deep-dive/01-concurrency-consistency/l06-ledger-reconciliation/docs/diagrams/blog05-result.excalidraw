   "link": null,
   "locked": false,
   "text": "SELECT COALESCE(a.id, l.account_id) AS id, a.balance, l.s\nFROM account a FULL OUTER JOIN (SELECT account_id, sum(amount) s FROM ledger GROUP BY account_id) l\n  ON l.account_id = a.id\nWHERE a.id IS NULL OR a.balance <> COALESCE(l.s, 0) ORDER BY 1",
   "originalText": "SELECT COALESCE(a.id, l.account_id) AS id, a.balance, l.s\nFROM account a FULL OUTER JOIN (SELECT account_id, sum(amount) s FROM ledger GROUP BY account_id) l\n  ON l.account_id = a.id\nWHERE a.id IS NULL OR a.balance <> COALESCE(l.s, 0) ORDER BY 1",
   "fontSize": 13,
   "fontFamily": 3,
