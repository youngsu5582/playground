   "text": "그래서 실무 대사는 기간과 허용 지연을 둔다",
   "originalText": "그래서 실무 대사는 기간과 허용 지연을 둔다",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "blog05-timing-text-15",
   "type": "text",
   "x": 56,
   "y": 328.0,
   "width": 916.72,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
