     public List<Mismatch> findMismatches() {
-        return List.of();
+        try (Connection c = db.get()) {
+            List<Mismatch> found = new ArrayList<>();
+            internal(c, found);
+            external(c, found);
+            return found;
+        } catch (SQLException e) {
+            throw new IllegalStateException(e);
+        }
     }
 
+    private static void internal(Connection c, List<Mismatch> found) throws SQLException {
+        String sql = """
+                SELECT COALESCE(a.id, l.account_id) AS account_id, a.id IS NULL AS no_account, a.balance, l.entries_sum
+                FROM account a
+                FULL OUTER JOIN (SELECT account_id, SUM(amount) AS entries_sum FROM ledger GROUP BY account_id) l
+                  ON l.account_id = a.id
+                WHERE a.id IS NULL OR a.balance <> COALESCE(l.entries_sum, 0)
+                ORDER BY 1""";
+        try (PreparedStatement ps = c.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {
+            while (rs.next()) {
+                String key = String.valueOf(rs.getInt("account_id"));
+                BigDecimal entriesSum = rs.getBigDecimal("entries_sum");
+                if (rs.getBoolean("no_account")) {
+                    found.add(new Mismatch(Mismatch.Kind.LEDGER_WITHOUT_ACCOUNT, key, null, entriesSum));
+                } else {
+                    found.add(new Mismatch(Mismatch.Kind.BALANCE_NOT_MATCH, key, rs.getBigDecimal("balance"),
+                            entriesSum == null ? BigDecimal.ZERO : entriesSum));
+                }
+            }
+        }
+    }
+
+    private static void external(Connection c, List<Mismatch> found) throws SQLException {
+        String sql = """
+                SELECT COALESCE(o.txn_id, e.txn_id) AS txn_id, o.amount AS ours, e.amount AS theirs
+                FROM (SELECT txn_id, amount FROM ledger WHERE amount > 0) o
+                FULL OUTER JOIN external_statement e ON e.txn_id = o.txn_id
+                WHERE o.txn_id IS NULL OR e.txn_id IS NULL OR o.amount <> e.amount
+                ORDER BY 1""";
+        try (PreparedStatement ps = c.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {
+            while (rs.next()) {
+                BigDecimal ours = rs.getBigDecimal("ours");
+                BigDecimal theirs = rs.getBigDecimal("theirs");
+                Mismatch.Kind kind = ours == null ? Mismatch.Kind.THEIRS_ONLY
+                        : theirs == null ? Mismatch.Kind.OURS_ONLY : Mismatch.Kind.AMOUNT_DIFFERS;
+                found.add(new Mismatch(kind, rs.getString("txn_id"), ours, theirs));
+            }
+        }
+    }
 }
